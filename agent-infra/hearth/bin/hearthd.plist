<?xml version="1.0" encoding="UTF-8"?>
<!-- hearthd as a LaunchAgent: the phone is useless if the daemon dies with the
     terminal it was started from. Install (your call, not the agent's):

       cp agent-infra/hearth/bin/hearthd.plist ~/Library/LaunchAgents/dev.hearth.hearthd.plist
       # edit WorkingDirectory/ProgramArguments below if the repo lives elsewhere
       launchctl load -w ~/Library/LaunchAgents/dev.hearth.hearthd.plist

     Stop:  launchctl unload -w ~/Library/LaunchAgents/dev.hearth.hearthd.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.hearth.hearthd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>/Users/dgreat/PycharmProjects/literate-octo-ai/agent-infra/hearth/hearthd/hearthd.py</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>8788</string>
    <string>--repo</string><string>/Users/dgreat/PycharmProjects/literate-octo-ai</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/dgreat/PycharmProjects/literate-octo-ai</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/hearthd.log</string>
  <key>StandardErrorPath</key><string>/tmp/hearthd.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/dgreat/.local/bin</string></dict>
</dict>
</plist>
