#!/usr/bin/env bash
# dsh-herdr — одноразовая агентная задача dsh с репортом статуса в Herdr.
#
#   dsh-herdr [-C dir] [-m provider/model] [-n label] "задача ..."
#
# Внутри Herdr-пейна репортит working → idle/blocked через `pane report-agent`,
# поэтому долгий headless-прогон виден в сайдбаре, а `herdr agent list` непуст.
# Вне Herdr — просто `dsh --profile headless`, тот же контракт.
#
# Допустимые статусы report-agent: idle | working | blocked | unknown.
# Статуса `done` НЕ существует — завершение репортится как idle с --message.
set -euo pipefail

SOURCE_ID="custom:dsh-herdr"
AGENT_LABEL="dsh"
WORKDIR="$PWD"
MODEL=""

usage() { grep '^#' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

while getopts "C:m:n:h" opt; do
  case "$opt" in
    C) WORKDIR="$OPTARG" ;;
    m) MODEL="$OPTARG" ;;
    n) AGENT_LABEL="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage
TASK="$*"

IN_HERDR=0
if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ] && [ -n "${HERDR_BIN_PATH:-}" ]; then
  IN_HERDR=1
fi

report() { # report <state> [message]
  [ "$IN_HERDR" = 1 ] || return 0
  local state="$1"; shift || true
  local args=("$HERDR_BIN_PATH" pane report-agent "$HERDR_PANE_ID"
              --source "$SOURCE_ID" --agent "$AGENT_LABEL" --state "$state")
  [ $# -ge 1 ] && args+=(--message "$1")
  "${args[@]}" >/dev/null 2>&1 || true
}

release() {
  [ "$IN_HERDR" = 1 ] || return 0
  "$HERDR_BIN_PATH" pane release-agent "$HERDR_PANE_ID" --source "$SOURCE_ID" \
    >/dev/null 2>&1 || true
}

DSH_ARGS=(--profile headless)
PATCH_FILE=""
if [ -n "$MODEL" ]; then
  case "$MODEL" in
    */*) ;;
    *) echo "dsh-herdr: -m ждёт provider/model, получил '$MODEL'" >&2; exit 2 ;;
  esac
  PATCH_FILE="$(mktemp -t dsh-herdr-model)"
  printf -- '- id: agent-default-model\n  config:\n    provider: %s\n    model: %s\n' \
    "${MODEL%%/*}" "${MODEL#*/}" > "$PATCH_FILE"
  DSH_ARGS+=(--patch "$PATCH_FILE")
fi

cleanup() {
  release
  [ -n "$PATCH_FILE" ] && rm -f "$PATCH_FILE"
}
trap cleanup EXIT

report working "${TASK:0:120}"
if (cd "$WORKDIR" && dsh "${DSH_ARGS[@]}" "$TASK"); then
  report idle "готово"
else
  code=$?
  report blocked "dsh вышел с кодом $code"
  exit "$code"
fi
